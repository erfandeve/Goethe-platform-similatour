# /etc/systemd/system/lexart-web.service
[Unit]
Description=LexArt web (Next.js standalone)
After=network.target lexart-api.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/lexart/web
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
