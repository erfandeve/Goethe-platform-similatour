# Read by deploy/build.sh on YOUR laptop at build time. NEXT_PUBLIC_* values
# are baked into the build, so a change here needs a rebuild and redeploy.
NEXT_PUBLIC_SITE_URL=https://lexart.ir
# The Next server reaches Django on the same machine.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010/api
# Empty = media from the same domain (nginx serves /media).
NEXT_PUBLIC_MEDIA_URL=
NEXT_PUBLIC_MAX_AUDIO_DURATION=60
# From Google Search Console / Bing Webmaster → "HTML tag" method (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Instagram, Telegram, YouTube… comma-separated full URLs.
NEXT_PUBLIC_SAME_AS=
# The inbox shown on the contact page, e.g. support@yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=
# Enamad trust-seal verification code
NEXT_PUBLIC_ENAMAD=
