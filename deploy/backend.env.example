# /var/www/lexart/backend/.env on the server. Never commit the real one.
DEBUG=False
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost,example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com
CORS_ORIGINS=https://example.com

MONGO_DB=lexart
MONGO_HOST=mongodb://127.0.0.1:27017/lexart

JWT_ACCESS_MINUTES=180
JWT_REFRESH_DAYS=14

# The first bootstrap creates this admin and removes the demo account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI speaking teacher — use a NEW key (the old one was exposed in a chat).
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# nginx serves /media itself.
SERVE_MEDIA=False
