# Where the Django API lives. On Vercel set this to your deployed backend.
NEXT_PUBLIC_API_URL=http://localhost:8010/api

# Public site URL, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where uploaded media is served from.
#   unset      → the API host (local development)
#   empty ("") → the same origin, i.e. the files in web/public/media (Vercel)
# NEXT_PUBLIC_MEDIA_URL=

# Client-side recording cap; the server enforces its own limit as well.
NEXT_PUBLIC_MAX_AUDIO_DURATION=60
